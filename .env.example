# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# ID платного канала (получить через @getidsbot или @userinfobot)
# Формат: -100XXXXXXXXXX для приватных каналов/групп
PREMIUM_CHANNEL_ID=-1001234567890

# OpenRouter API Key (получить на https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Модель для генерации (по умолчанию: anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Лимит генераций в месяц на пользователя
MONTHLY_LIMIT=10

# HTTP порт для health check (Railway/Render автоматически установят)
# Оставьте пустым для локального запуска, будет использован порт 3000
PORT=

# Webhook домен для production (Railway/Render)
# Если указан - бот использует webhook, иначе - polling
# Пример: your-app.railway.app (БЕЗ https://)
# Для локальной разработки оставьте пустым
WEBHOOK_DOMAIN=
